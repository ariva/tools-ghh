# --- two stashes -----------------------------------------------------------
# stash <git stash push arguments>: with a fixed date and author, like commit()
stash() {
    local stamp
    MINUTE=$((MINUTE + 47))
    stamp="$(date -u -d "2026-03-02 09:00 UTC + $MINUTE minutes" '+%Y-%m-%dT%H:%M:%S+00:00')"
    GIT_AUTHOR_NAME="Ines Duarte" GIT_AUTHOR_EMAIL="ines.duarte@example.com" GIT_AUTHOR_DATE="$stamp" \
        GIT_COMMITTER_NAME="Ines Duarte" GIT_COMMITTER_EMAIL="ines.duarte@example.com" GIT_COMMITTER_DATE="$stamp" \
        git stash push -q "$@"
}

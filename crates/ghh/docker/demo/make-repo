#!/usr/bin/env bash
# Builds the repository the demo shows: `make-repo <dir>`. A small fake
# "shop-api" with three merged pull requests, two tags, three plain
# commits on top (the ones `E` can move) and two stashes. Every name, date and line of code in it is made up; dates are
# fixed so two recordings show the same list.
set -euo pipefail

REPO="${1:?usage: make-repo <dir>}"
mkdir -p "$REPO"
cd "$REPO"
git init -q -b main
git config user.name "Dev"
git config user.email "dev@example.com"
git config commit.gpgsign false

MINUTE=0
# commit <author> <message>: everything in the working tree, 47 minutes after the previous one
commit() {
    local author="$1" message="$2" email stamp
    email="$(tr 'A-Z ' 'a-z.' <<<"$author")@example.com"
    MINUTE=$((MINUTE + 47))
    stamp="$(date -u -d "2026-03-02 09:00 UTC + $MINUTE minutes" '+%Y-%m-%dT%H:%M:%S+00:00')"
    git add -A
    GIT_AUTHOR_NAME="$author" GIT_AUTHOR_EMAIL="$email" GIT_AUTHOR_DATE="$stamp" \
        GIT_COMMITTER_NAME="$author" GIT_COMMITTER_EMAIL="$email" GIT_COMMITTER_DATE="$stamp" \
        git commit -q --allow-empty -m "$message"
}

# merge_pr <number> <branch> <title>: the commit GitHub's merge button writes
merge_pr() {
    local number="$1" branch="$2" title="$3" stamp
    MINUTE=$((MINUTE + 47))
    stamp="$(date -u -d "2026-03-02 09:00 UTC + $MINUTE minutes" '+%Y-%m-%dT%H:%M:%S+00:00')"
    git checkout -q main
    GIT_AUTHOR_NAME="Ines Duarte" GIT_AUTHOR_EMAIL="ines.duarte@example.com" GIT_AUTHOR_DATE="$stamp" \
        GIT_COMMITTER_NAME="Ines Duarte" GIT_COMMITTER_EMAIL="ines.duarte@example.com" GIT_COMMITTER_DATE="$stamp" \
        git merge -q --no-ff "$branch" -m "Merge pull request #$number from shop/$branch" -m "$title"
    git branch -q -d "$branch"
}

